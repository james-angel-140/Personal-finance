# Copy this file to ".env" and fill in real values.
# .env is gitignored and must never be committed.

# — Monzo developer API (https://developers.monzo.com) —
# Create a "confidential" client so you receive a refresh token.
MONZO_CLIENT_ID=
MONZO_CLIENT_SECRET=
MONZO_REDIRECT_URI=http://localhost:8080/callback

# — Anthropic API (for the categorisation + chat layers) —
# The app's AI features call the API directly and need their own key.
ANTHROPIC_API_KEY=

# — Local data —
DB_PATH=data/finance.db
